+configure_zero2_power(){
+  # Pagina Rete: sul Pi Zero 2 W con modem LTE (Air780E) ogni mA risparmiato allarga il margine
+  # sui picchi di corrente del modem: Bluetooth e LED spenti. NON abbassare arm_freq: con 800 MHz
+  # (02-05/10) il ricevitore sulla USB restava muto per minuti (timeout dwc_otg "FSM NP transfer").
+  BOOTCONFIG=$1/${CONFIG}
+  [[ -f ${BOOTCONFIG} ]] || return
+  grep -q "Raspberry Pi Zero 2" /proc/device-tree/model 2>/dev/null || return
+  grep -q "^DO NOT EDIT THIS FILE" ${BOOTCONFIG} && return
+  grep -q "^# EVONETRTKBASE: meno consumi" ${BOOTCONFIG} && return
+  printf '%s\n' "[all]" "# EVONETRTKBASE: meno consumi (picchi del modem LTE)" \
+     "dtoverlay=disable-bt" "dtparam=act_led_trigger=none" "dtparam=act_led_activelow=on" >> ${BOOTCONFIG}
+  ExitCodeCheck $?
+  systemctl disable bluetooth.service >/dev/null 2>&1
+  echo ${BOOTCONFIG}: Pi Zero 2 W a basso consumo
+  NEEDREBOOT=Y
+}
